# Copy this file to .env and fill in your details. .env is never committed.

# --------------------------------------------------------------- Deployment
# On Render the app reads RENDER_EXTERNAL_URL automatically, so BASE_URL can be
# left unset there. Set BASE_URL only for a custom domain or another host.
# Add SMTP_* and GOOGLE_* in the Render dashboard (Environment page), not here.
# Fine to leave SMTP and Google blank until you are ready: verification and
# reset emails just will not send, and the Google button stays hidden.

# Where the app thinks it lives. Used to build links inside emails.
BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- SMTP delivery
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-character-app-password
#
# Outlook / Hotmail: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
# Yahoo:             SMTP_HOST=smtp.mail.yahoo.com,     SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Port 465 uses implicit SSL; 587 uses STARTTLS. Override only if your provider differs.
SMTP_SSL=false
SMTP_STARTTLS=true

# Sender shown in the inbox. Defaults to SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=MotorScope

# ------------------------------------------------------------------- Sessions
# Leave blank to auto-generate a persistent key in data/secret.key
SECRET_KEY=

SESSION_MAX_AGE_MINUTES=720
VERIFY_TOKEN_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=30

# ----------------------------------------------------------------- Sign-in lock
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

PASSWORD_MIN_LENGTH=10

# Leave as-is for the bundled SQLite file in data/motorscope.db
DATABASE_PATH=

# ------------------------------------------------------------ Google sign-in
# No API needs enabling. The openid/email/profile scopes are part of Google's
# built-in OpenID Connect support.
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Pick or create a project
# 3. "Google Auth Platform" > Branding:
#      App name:   MotorScope
#      Support email, developer contact:  your own address
# 4. "Google Auth Platform" > Audience:  External, leave publishing status "Testing"
# 5. "Google Auth Platform" > Data Access: the default openid/email/profile
#    scopes are already listed. Add nothing.
# 6. "Google Auth Platform" > Clients > Create client > Application type:
#    "Web application"
#      Authorized redirect URI:  http://127.0.0.1:8000/auth/google/callback
#      Authorized JavaScript origin:  http://127.0.0.1:8000
# 7. Copy the client ID and client secret. THE SECRET IS SHOWN ONLY ONCE and
#    cannot be viewed again. If you lose it, create a new client.
#
# Leave both blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered with Google.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
